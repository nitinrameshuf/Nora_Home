# Nora Home configuration. Copy to .env and fill in.
# Nothing in here is read at import time except through config/settings/base.py:env().

# ── Core ────────────────────────────────────────────────────────────────────
NORA_HOME_ENV=dev                       # dev | pi | prod
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-50-random-characters
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nora.home,nora.local
DJANGO_TIME_ZONE=America/Los_Angeles
NORA_HOME_NAME=Nora Home

# ── Relational database (MySQL in production, SQLite in dev) ────────────────
NORA_HOME_DB_ENGINE=sqlite              # sqlite | mysql
NORA_HOME_DB_NAME=nora_home
NORA_HOME_DB_USER=nora
NORA_HOME_DB_PASSWORD=
NORA_HOME_DB_HOST=127.0.0.1
NORA_HOME_DB_PORT=3306

# ── MongoDB (documents, journals, AI transcripts, raw integration payloads) ─
NORA_HOME_MONGO_URI=mongodb://127.0.0.1:27017
NORA_HOME_MONGO_DB=nora_home

# ── Redis (cache, channels layer, celery results, rate limits) ─────────────
NORA_HOME_REDIS_URL=redis://127.0.0.1:6379/0

# ── RabbitMQ (celery broker) ───────────────────────────────────────────────
NORA_HOME_AMQP_URL=amqp://nora:nora@127.0.0.1:5672//
# Set to 1 to use Redis as the broker instead (useful on a laptop).
NORA_HOME_BROKER_USE_REDIS=0

# ── Object storage (MinIO on the Pi, or S3) ────────────────────────────────
NORA_HOME_S3_ENDPOINT_URL=http://127.0.0.1:9000
NORA_HOME_S3_ACCESS_KEY=nora
NORA_HOME_S3_SECRET_KEY=
NORA_HOME_S3_BUCKET=nora-home
NORA_HOME_S3_REGION=us-east-1
NORA_HOME_S3_USE_SSL=0
# When 0, uploads go to MEDIA_ROOT on local disk instead of object storage.
NORA_HOME_S3_ENABLED=0

# ── Slack ──────────────────────────────────────────────────────────────────
NORA_HOME_SLACK_BOT_TOKEN=
NORA_HOME_SLACK_DEFAULT_CHANNEL=#nora-home
NORA_HOME_SLACK_ESCALATION_CHANNEL=#nora-home-alerts
# Simpler alternative to a bot token; used when the token is blank.
NORA_HOME_SLACK_WEBHOOK_URL=

# ── AI (Claude API) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
NORA_HOME_AI_MODEL=claude-sonnet-5
NORA_HOME_AI_FAST_MODEL=claude-haiku-4-5
NORA_HOME_AI_EFFORT=high                # low | medium | high | xhigh | max
NORA_HOME_AI_DEEP_MODEL=claude-opus-5
NORA_HOME_AI_MAX_TOKENS=4096
NORA_HOME_AI_MONTHLY_BUDGET_USD=25

# ── MCP server ─────────────────────────────────────────────────────────────
NORA_HOME_MCP_ENABLED=1
NORA_HOME_MCP_TOKEN=                    # shared secret for the HTTP MCP endpoint

# ── Displays ───────────────────────────────────────────────────────────────
# The 24" 1080p always-on wall display and the 10.1" kiosk controller.
NORA_HOME_MAIN_DISPLAY_SLUG=wall
NORA_HOME_KIOSK_DISPLAY_SLUG=kiosk
NORA_HOME_DISPLAY_ROTATE_SECONDS=45

# ── Backups ────────────────────────────────────────────────────────────────
NORA_HOME_BACKUP_DIR=/var/backups/nora
NORA_HOME_BACKUP_RETAIN_DAYS=30
NORA_HOME_BACKUP_TO_OBJECT_STORAGE=0

# ── Observability ──────────────────────────────────────────────────────────
NORA_HOME_LOG_LEVEL=INFO
NORA_HOME_LOG_DIR=logs
SENTRY_DSN=
