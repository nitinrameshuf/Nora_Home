# Nora Home configuration. Copy to .env and fill in.
# Nothing in here is read at import time except through config/settings/base.py:env().

# ── Core ────────────────────────────────────────────────────────────────────
NORA_HOME_ENV=dev                       # dev | pi | prod
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-50-random-characters
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nora.home,nora.local
DJANGO_TIME_ZONE=America/Los_Angeles
NORA_HOME_NAME=Nora Home

# ── Relational database (MySQL in production, SQLite in dev) ────────────────
NORA_HOME_DB_ENGINE=sqlite              # sqlite | mysql
NORA_HOME_DB_NAME=nora_home
NORA_HOME_DB_USER=nora
NORA_HOME_DB_PASSWORD=
NORA_HOME_DB_HOST=127.0.0.1
NORA_HOME_DB_PORT=3306

# ── MongoDB (documents, journals, AI transcripts, raw integration payloads) ─
NORA_HOME_MONGO_URI=mongodb://127.0.0.1:27017
NORA_HOME_MONGO_DB=nora_home

# ── Redis (cache, channels layer, celery results, rate limits) ─────────────
NORA_HOME_REDIS_URL=redis://127.0.0.1:6379/0

# ── RabbitMQ (celery broker) ───────────────────────────────────────────────
NORA_HOME_AMQP_URL=amqp://nora:nora@127.0.0.1:5672//
# Set to 1 to use Redis as the broker instead (useful on a laptop).
NORA_HOME_BROKER_USE_REDIS=0

# ── Object storage (MinIO on the Pi, or S3) ────────────────────────────────
NORA_HOME_S3_ENDPOINT_URL=http://127.0.0.1:9000
NORA_HOME_S3_ACCESS_KEY=nora
NORA_HOME_S3_SECRET_KEY=
NORA_HOME_S3_BUCKET=nora-home
NORA_HOME_S3_REGION=us-east-1
NORA_HOME_S3_USE_SSL=0
# When 0, uploads go to MEDIA_ROOT on local disk instead of object storage.
NORA_HOME_S3_ENABLED=0

# ── Slack ──────────────────────────────────────────────────────────────────
# No quotes around any value in this file. Compose passes env_file values through
# literally, so NORA_HOME_SLACK_BOT_TOKEN="xoxb-..." sends a token that starts
# with a double-quote character and Slack rejects it. Paste the bare token.
#
# The bot token needs these scopes, and the app must be reinstalled after adding
# any of them:
#   chat:write          post at all
#   chat:write.public   post to a channel without being invited to it first
#                       (otherwise: /invite @your-bot in each channel below)
#   im:write            DM a person — the escalation ladder depends on this
#   users:read          optional; look members up by email rather than by hand
#
# Per-person DMs also need HouseMember.slack_user_id filled in (Slack profile ->
# "Copy member ID", then set it in /admin/). Without it, personal notifications
# fall back to the default channel.
NORA_HOME_SLACK_BOT_TOKEN=
NORA_HOME_SLACK_DEFAULT_CHANNEL=#nora-home
NORA_HOME_SLACK_ESCALATION_CHANNEL=#nora-home-alerts
# Simpler alternative to a bot token; used when the token is blank.
NORA_HOME_SLACK_WEBHOOK_URL=

# Socket Mode only (Story 37) — a separate credential from the bot token above,
# generated on the app's own Basic Information page under "App-Level Tokens",
# scope connections:write. Lets the house open an outbound websocket to Slack
# instead of needing a public URL, since the Pi is behind home NAT with a
# self-signed cert. Not read by anything yet; the setting is wired up when the
# Socket Mode container is built. Unlike the general "App Configuration
# Tokens" on Slack's Your Apps page, this one does not expire.
NORA_HOME_SLACK_APP_TOKEN=

# ── AI (Claude API) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
NORA_HOME_AI_MODEL=claude-sonnet-5
NORA_HOME_AI_FAST_MODEL=claude-haiku-4-5
NORA_HOME_AI_EFFORT=high                # low | medium | high | xhigh | max
NORA_HOME_AI_DEEP_MODEL=claude-opus-5
NORA_HOME_AI_MAX_TOKENS=4096
NORA_HOME_AI_MONTHLY_BUDGET_USD=25

# ── Speech (the house's voice) ─────────────────────────────────────────────
# Leave the provider as "none" and the house still runs — chime and file alarms
# work, only spoken ones go quiet. Set it to "groq" and add the key to give the
# house a voice, for Todo's speech alarms and anything else calling
# nora_home.notifications.speech.speak().
NORA_HOME_TTS_PROVIDER=none             # none | groq
NORA_HOME_GROQ_API_KEY=
NORA_HOME_TTS_MODEL=canopylabs/orpheus-v1-english
NORA_HOME_TTS_VOICE=hannah              # autumn | diana | hannah | austin | daniel | troy

# ── MCP server ─────────────────────────────────────────────────────────────
NORA_HOME_MCP_ENABLED=1
NORA_HOME_MCP_TOKEN=                    # shared secret for the HTTP MCP endpoint

# ── Displays ───────────────────────────────────────────────────────────────
# The 24" 1080p always-on wall display and the 10.1" kiosk controller.
NORA_HOME_MAIN_DISPLAY_SLUG=wall
NORA_HOME_KIOSK_DISPLAY_SLUG=kiosk

# ── TLS (nginx reverse proxy, docker-compose only) ──────────────────────────
# nginx terminates HTTPS in front of the app and redirects plain HTTP to it —
# see nginx/ and scripts/gen-self-signed-cert.sh. Self-signed by default (no
# public domain on a house LAN); browsers warn once per device on first visit,
# see docs/deployment.html. Not used by `manage.py runserver` (dev.py never
# enables SECURE_SSL_REDIRECT) — only relevant when running via Docker Compose.
NORA_HOME_HTTP_PORT=80
NORA_HOME_HTTPS_PORT=443
NORA_HOME_FORCE_HTTPS=1

# ── Location ───────────────────────────────────────────────────────────────
# Drives the weather integration and the living background's season/day-night
# axes (nora_home/ui/scene.py). No API key needed — just where the house is.
# Defaults to New York City; correct these two for the house's real location.
NORA_HOME_LAT=40.7128
NORA_HOME_LON=-74.0060

# ── Backups ────────────────────────────────────────────────────────────────
NORA_HOME_BACKUP_DIR=/var/backups/nora
NORA_HOME_BACKUP_RETAIN_DAYS=30
NORA_HOME_BACKUP_TO_OBJECT_STORAGE=0

# ── Alarms (Story 38) ──────────────────────────────────────────────────────
# Where a resolved alarm's audio lands so the host-side player can reach it —
# must match docker-compose.yml's bind mount (./var/alarms:/srv/nora/alarms).
# Django runs in Docker with no path to the physical speakers; this directory
# is the handoff, same boundary the wall power schedule crosses.
NORA_HOME_ALARM_CACHE_DIR=/srv/nora/alarms

# ── Observability ──────────────────────────────────────────────────────────
NORA_HOME_LOG_LEVEL=INFO
NORA_HOME_LOG_DIR=logs
SENTRY_DSN=
